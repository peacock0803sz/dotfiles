{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>peacock0803sz/renovate-config"],
  "enabledManagers": ["npm", "deno"],
  "includePaths": [
    "~/dotfiles/dot_config/agents/pi/extensions/",
    "~/dotfiles/dot_config/nvim/huge/ts/ddu/"
  ],
  "commitMessagePrefix": "",
  "packageRules": [
    {
      "description": "oxlint と oxfmt は同じ oxc リリース系列なのでまとめて上げる",
      "matchPackageNames": ["oxlint", "oxfmt"],
      "groupName": "oxc tools"
    },
    {
      "description": "ddu 本体と UI/kind は互換性が揃っている必要があるためまとめて上げる",
      "matchPackageNames": ["@shougo/**", "@denops/**"],
      "groupName": "ddu"
    }
  ]
}
