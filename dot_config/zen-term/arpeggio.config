# vim: ft=ghostty
# ZenTerm (https://github.com/praxis-labs-io/zen-term) の設定
# ghostty/base.config + tmux/conf 相当。include がないので nocturne.config とは font-size 以外同一に保つ
# Settings 画面 (⌘,) で変更すると、symlink を辿ってこのファイルが書き換わる

# ─── 見た目 (ghostty/*.config 相当) ───
# ~/.config/zen-term/themes/peafowl.conf (peafowl-colors への symlink) を読む
# cursor-color は無視され、カーソルは accent-color (既定 blue = palette 4) で描かれる
theme = peafowl.conf
font-family = UDEV Gothic NF
font-size = 12
macos-option-as-alt = true
scroll-multiplier = 0.5

# ─── シェル ───
# ワークスペースの main/right/bottom は `<shell> -l -i -c <command>` で起動されるので、
# zmx.fish の関数 (zmx-pane) が使えるよう fish を明示する
shell = /run/current-system/sw/bin/fish
# tmux の new-window -c "#{pane_current_path}" 相当
tab-inherit-cwd = true

# ─── エージェント ───
# claude / codex は組み込み。pi は notify スクリプトが通知タイトル "pi" で OSC 777 を送るので、それで判定される
agents = pi

# ─── キーバインド (tmux/conf 相当) ───
# ZenTerm にはプレフィックスキーが無いので、tmux の Alt (M-) バインドは opt+ にそのまま移し、
# prefix テーブルにしかなかったものは opt / ctrl+opt の空いている組み合わせに寄せる。
# ここで受けた組み合わせはシェルや nvim には届かない (tmux の bind -n と同じ)。
# 1 アクション 1 ショートカットなので、上書きしたアクションの既定 (⌘D など) は外れる

# window (= タブ)
keybind = new_tab=opt+s                  # M-s  new-window -c pane_current_path
keybind = next_tab=opt+shift+j           # M-J  next-window
keybind = prev_tab=opt+shift+k           # M-K  previous-window
# close_tab (prefix q) は既定の ⌘⌥W のまま

# pane
keybind = split_vertical=opt+v           # M-v  split-window -h (右に新しいペイン)
keybind = split_horizontal=opt+x         # M-x  split-window -v (下に新しいペイン)
keybind = close_pane=opt+q               # prefix M-q  kill-pane (zmx 上のペインでは detach になる)
# prefix h/j/k/l。fish 既定の alt-h (man) と alt-l (ls) は使えなくなる
keybind = nav_left=opt+h
keybind = nav_down=opt+j
keybind = nav_up=opt+k
keybind = nav_right=opt+l
# prefix H/J/K/L (-r)。押しっぱなしでリピートする
keybind = resize_left=ctrl+opt+h
keybind = resize_down=ctrl+opt+j
keybind = resize_up=ctrl+opt+k
keybind = resize_right=ctrl+opt+l
# prefix V / X (split-window -f) の代わりに、タブ全体の右端・下端に付くドロワーを開閉する
keybind = toggle_right_drawer=opt+shift+v
keybind = toggle_bottom_drawer=opt+shift+x

# session (= ワークスペース)
keybind = new_workspace=opt+shift+s      # M-S  new-session -c ~/ (ホームで新しいワークスペースを作る)
keybind = next_workspace=opt+shift+l     # M-L  switch-client -n
keybind = prev_workspace=opt+shift+h     # M-H  switch-client -p
# close_workspace (prefix Q) は既定の ⌘⌃W のまま

# copy-mode-vi (prefix [) の代わりにスクロールモードに入る。v / V で選択、y でコピー (矩形選択は無い)
keybind = toggle_scroll_mode=opt+[
